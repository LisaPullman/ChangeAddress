# Cloudflare Pages — caching & security headers
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML: never cache so edits are seen immediately on the next deploy
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS / JS / brand assets: filenames are NOT content-hashed (style.css,
# script.js, article.css), so browsers must revalidate to pick up deploys.
# Cloudflare's edge still caches — revalidation is a cheap 304.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Once asset URLs carry a version (?v=2 or a content hash), swap the three
# rules above to:  Cache-Control: public, max-age=31536000, immutable

# Security headers for everything
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
