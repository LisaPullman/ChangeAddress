# Cloudflare Pages — redirects & rewrites
# https://developers.cloudflare.com/pages/configuration/redirects/

# Force HTTPS (Pages already does this, but explicit is friendlier)
/http://c.qifei2035.eu.cc/*  https://c.qifei2035.eu.cc/:splat  301

# Short alias for the homepage
/c  /index.html  301

# No global fallback: unknown paths now return a real CF Pages 404 instead
# of being silently rewritten to the homepage. This keeps the access log
# clean (typos and bot probes don't all look like index hits) and avoids
# SEO confusion from soft-404 patterns.